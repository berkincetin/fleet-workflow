# Postgres
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet_dev_pw
POSTGRES_DB=fleet
# Keycloak admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# MinIO
MINIO_ROOT_USER=fleet
MINIO_ROOT_PASSWORD=fleet_dev_pw
# Langfuse
LANGFUSE_SALT=changeme_dev_salt
NEXTAUTH_SECRET=changeme_dev_secret
# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
# LLM gateway (LiteLLM) — Sprint 2
# master_key gates the proxy admin/management API and virtual-key issuance.
LITELLM_MASTER_KEY=sk-fleet-dev-master
# Provider API keys (Sprint 0 prerequisites). Leave blank to run the proxy with
# only the local (Ollama) lane; cloud models return auth errors until set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ollama base URL for the pii/local lane (host-native GPU). From inside compose
# containers, reach the host via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Langfuse keys for the proxy's success/failure callback (TRD §6). Create a
# project in the Langfuse UI (http://localhost:3001) and paste its keys here;
# leave blank to run without tracing. LANGFUSE_HOST points the proxy at the
# self-hosted instance (from inside compose: http://langfuse:3000).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
# Web shell — Sprint 3 (apps/web). AUTH_SECRET is NextAuth v5's env var name
# (NEXTAUTH_SECRET above is kept for the compose/back-end side; both may point
# at the same value). KEYCLOAK_CLIENT_SECRET matches the fleet-realm.json seed.
AUTH_SECRET=changeme_dev_secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/fleet
KEYCLOAK_CLIENT_ID=fleet-api
KEYCLOAK_CLIENT_SECRET=fleet-api-dev-secret
FLEET_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_FLEET_API_BASE_URL=http://localhost:8000
