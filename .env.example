# Postgres
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet_dev_pw
POSTGRES_DB=fleet
# Keycloak admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# MinIO
MINIO_ROOT_USER=fleet
MINIO_ROOT_PASSWORD=fleet_dev_pw
# Langfuse
LANGFUSE_SALT=changeme_dev_salt
NEXTAUTH_SECRET=changeme_dev_secret
# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
# LLM gateway (LiteLLM) — Sprint 2
# master_key gates the proxy admin/management API and virtual-key issuance.
LITELLM_MASTER_KEY=sk-fleet-dev-master
# Provider API keys (Sprint 0 prerequisites). Leave blank to run the proxy with
# only the local (Ollama) lane; cloud models return auth errors until set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ollama base URL for the pii/local lane (host-native GPU). From inside compose
# containers, reach the host via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Langfuse keys for the proxy's success/failure callback (TRD §6). Create a
# project in the Langfuse UI (http://localhost:3001) and paste its keys here;
# leave blank to run without tracing. LANGFUSE_HOST points the proxy at the
# self-hosted instance (from inside compose: http://langfuse:3000).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
# Web shell — Sprint 3 (apps/web). AUTH_SECRET is NextAuth v5's env var name
# (NEXTAUTH_SECRET above is kept for the compose/back-end side; both may point
# at the same value). KEYCLOAK_CLIENT_SECRET matches the fleet-realm.json seed.
AUTH_SECRET=changeme_dev_secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/fleet
KEYCLOAK_CLIENT_ID=fleet-api
KEYCLOAK_CLIENT_SECRET=fleet-api-dev-secret
FLEET_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_FLEET_API_BASE_URL=http://localhost:8000
# n8n editor link shown to MANAGE_AGENTS users on the /automations page (task
# 6.5.7) — behind the SSO proxy, never the loopback-only REST port above.
NEXT_PUBLIC_N8N_EDITOR_URL=http://localhost:5679
# n8n queue mode + SSO proxy — Sprint 6 (task 6.1). N8N_ENCRYPTION_KEY encrypts
# stored workflow credentials at rest; N8N_PROXY_COOKIE_SECRET is oauth2-proxy's
# session cookie key (must be a 16/24/32-byte value, base64 or plain — the
# default below is dev-only, a plain 24-byte string, not an encoded secret).
# Humans reach n8n's editor only via the proxy at http://localhost:5679; the
# Fleet API reaches n8n's REST API directly over a loopback-only port at
# http://localhost:5678 (task 6.5.4) — never exposed beyond the host.
N8N_ENCRYPTION_KEY=fleet_dev_n8n_encryption_key
N8N_PROXY_COOKIE_SECRET=fleet_dev_cookie_secretx
# Fleet API key n8n workflows use to call /v1/service/* (task 6.1/6.2/6.3).
# Issue one via POST /v1/admin/api-keys (scopes: pg_ro, slack_post) and paste
# the raw key here — it's shown only once at issuance. Leave blank and
# service-authenticated workflow steps will get a 401.
N8N_FLEET_API_KEY=
# Override only if fleet-api isn't reachable at the default
# host.docker.internal:8000 from inside the n8n containers.
FLEET_API_BASE_URL_FOR_N8N=http://host.docker.internal:8000
# n8n's own REST API key, for the Fleet API's workflows router (task 6.5.3/
# 6.5.4) to list/activate/deactivate workflows and read execution history.
# Created once in the n8n editor (Settings -> API -> Create an API key) —
# n8n has no headless bootstrap for this. Leave blank and the /v1/workflows
# catalog will report every workflow as reachable but with an auth error.
FLEET_N8N_API_KEY=
