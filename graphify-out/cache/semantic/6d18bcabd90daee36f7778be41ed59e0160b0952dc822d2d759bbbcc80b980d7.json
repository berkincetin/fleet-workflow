{"nodes": [{"id": "infra_compose_docker_compose_dev_n8n_main", "label": "n8n-main service (queue mode editor/API)", "file_type": "code", "source_file": "infra/compose/docker-compose.dev.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "infra_compose_docker_compose_dev_n8n_worker", "label": "n8n-worker service (Bull/Redis queue consumer)", "file_type": "code", "source_file": "infra/compose/docker-compose.dev.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "infra_compose_docker_compose_dev_n8n_oauth2_proxy", "label": "n8n-oauth2-proxy service (Keycloak SSO gate)", "file_type": "code", "source_file": "infra/compose/docker-compose.dev.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "n8n_queue_mode_rationale", "label": "n8n queue mode rationale (TRD \u00a73/\u00a715)", "file_type": "rationale", "source_file": "infra/compose/docker-compose.dev.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "main handles the editor UI/API and enqueues executions; worker(s) pull from the same Redis queue and actually run workflows -- this is what 'scales to hundreds of automations' means in practice (adding workers scales throughput without touching main). Redis DB 2 keeps the queue isolated from rate-limiting (DB 0) and RAG ingestion (DB 1). n8n-main is not reachable directly by design -- see n8n-oauth2-proxy."}, {"id": "n8n_sso_proxy_rationale", "label": "n8n SSO proxy rationale (fair-code license forbids embedding)", "file_type": "rationale", "source_file": "infra/compose/docker-compose.dev.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "n8n's fair-code license forbids white-label embedding, so it must live on its own reachable surface, gated by Keycloak rather than folded into Fleet's own auth. A real OIDC authorization-code flow against the same fleet realm every other component uses; unauthenticated requests get redirected to Keycloak login, never proxied through to n8n-main."}], "edges": [{"source": "infra_compose_docker_compose_dev_n8n_main", "target": "infra_compose_docker_compose_dev_n8n_worker", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "infra/compose/docker-compose.dev.yml", "source_location": null, "weight": 1.0}, {"source": "infra_compose_docker_compose_dev_n8n_main", "target": "infra_compose_docker_compose_dev_redis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "infra/compose/docker-compose.dev.yml", "source_location": null, "weight": 1.0}, {"source": "infra_compose_docker_compose_dev_n8n_worker", "target": "infra_compose_docker_compose_dev_redis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "infra/compose/docker-compose.dev.yml", "source_location": null, "weight": 1.0}, {"source": "infra_compose_docker_compose_dev_n8n_main", "target": "infra_compose_docker_compose_dev_postgres", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "infra/compose/docker-compose.dev.yml", "source_location": null, "weight": 1.0}, {"source": "infra_compose_docker_compose_dev_n8n_oauth2_proxy", "target": "infra_compose_docker_compose_dev_n8n_main", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "infra/compose/docker-compose.dev.yml", "source_location": null, "weight": 1.0}, {"source": "infra_compose_docker_compose_dev_n8n_oauth2_proxy", "target": "infra_compose_docker_compose_dev_keycloak", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "infra/compose/docker-compose.dev.yml", "source_location": null, "weight": 1.0}, {"source": "n8n_sso_proxy_rationale", "target": "infra_compose_docker_compose_dev_n8n_oauth2_proxy", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "infra/compose/docker-compose.dev.yml", "source_location": null, "weight": 1.0}, {"source": "n8n_queue_mode_rationale", "target": "infra_compose_docker_compose_dev_n8n_worker", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "infra/compose/docker-compose.dev.yml", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "n8n_stack_hyperedge", "label": "n8n queue-mode automation stack (main + worker + SSO proxy)", "nodes": ["infra_compose_docker_compose_dev_n8n_main", "infra_compose_docker_compose_dev_n8n_worker", "infra_compose_docker_compose_dev_n8n_oauth2_proxy", "infra_compose_docker_compose_dev_keycloak"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "infra/compose/docker-compose.dev.yml"}]}