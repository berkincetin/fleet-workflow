ull, "author": null, "contributor": null}, {"id": "analytics_service_ask_analytics", "label": "agents/analytics/service.py (ask_analytics)", "file_type": "code", "source_file": "docs/PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "trace_id_forwarding_bug", "label": "Rationale: trace_id/agent_id forwarding gap across LLMClient and answer_query", "file_type": "rationale", "source_file": "docs/PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LLMClient._call()/.embeddings()/.reasoning_stream() never forwarded trace_id/agent_id/user_id/dept_id to the transport layer, so Langfuse minted its own random trace id instead of correlating with Fleet's spend_ledger.trace_id. This blocked the 'feedback lands in Langfuse' AC for 4.3, and the same gap existed one layer up in fleet_rag.query.service.answer_query() for 4.4's RAG chat path. Fixed by forwarding **meta from all LLMClient methods to Transport calls; verified live via Langfuse API 404 to 200 before/after."}, {"id": "killswitch_bytes_bug", "label": "Rationale: KillSwitch bytes vs str Redis decoding bug", "file_type": "rationale", "source_file": "docs/PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "redis.asyncio.Redis.get() returns raw bytes unless decode_responses=True, so value == '1' was silently always False against the real client, meaning a paused agent would have kept running in production. Caught specifically because the AC required live proof, not mocks. Fixed at the source in _is_flag_set() to accept str | bytes | None."}, {"id": "presidio_tr_false_positive", "label": "Rationale: Presidio TR recognizer false-positive on generic nouns", "file_type": "rationale", "source_file": "docs/PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cs-help-center's pii_policy=redact false-positive-flagged generic Turkish nouns ('Kredi', 'Kart\u0131') as [PERSON], silently stripping 'kredi kart\u0131 kabul ediyoruz' from RAG context. Per explicit user decision, not fixed in Sprint 4; eval assertion corrected instead and logged as a tracked Sprint-8 KVKK-lane improvement item."}, {"id": "next_dev_input_desync_bug", "label": "Rationale: React controlled-input DOM/state desync under next dev", "file_type": "rationale", "source_file": "docs/PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Playwright's .fill() visibly set the DOM value but the Send button stayed disabled because React's state was never actually updated, root-caused to next dev's fast-refresh instrumentation. Running E2E against next build && next start instead resolved it with no source change; documented in playwright.config.ts."}, {"id": "sql_generator_markdown_fence_bug", "label": "Rationale: SQL generator markdown code-fence wrapping JSON", "file_type": "rationale", "source_file": "docs/PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "make eval AGENT=analytics failed 100% of cases on first live run because the model wrapped its required JSON response in a markdown code fence despite the system prompt saying not to. Fixed with a _strip_code_fence() helper plus a prompt tweak; unit tests alone never would have found this since the fake LLM always returned bare JSON."}], "edges": [{"source": "docs_progress_task_4_4_support_copilot", "target": "github_workflows_nightly", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PROGRESS.md", "source_location": null, "weight": 1.0}, {"source": "docs_progress", "target": "docs_progress_task_4_1_runtime_core", "relation": "references", "confidence": "EXTRACTED", "co