{
  "realm": "fleet",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "fleet-api",
      "enabled": true,
      "publicClient": false,
      "secret": "fleet-api-dev-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"]
    },
    {
      "clientId": "n8n",
      "enabled": true,
      "publicClient": false,
      "secret": "n8n-oauth2-proxy-dev-secret",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:5679/oauth2/callback"],
      "webOrigins": ["http://localhost:5679"],
      "protocolMappers": [
        {
          "name": "aud-n8n",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "n8n",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      { "name": "platform_admin" },
      { "name": "dept_admin" },
      { "name": "builder" },
      { "name": "approver" },
      { "name": "member" }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@fleet.local",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["platform_admin", "member"]
    },
    {
      "username": "deptadmin",
      "enabled": true,
      "email": "deptadmin@fleet.local",
      "firstName": "Department",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "deptadmin", "temporary": false }],
      "realmRoles": ["dept_admin", "member"]
    },
    {
      "username": "builder",
      "enabled": true,
      "email": "builder@fleet.local",
      "firstName": "Builder",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "builder", "temporary": false }],
      "realmRoles": ["builder", "member"]
    },
    {
      "username": "approver",
      "enabled": true,
      "email": "approver@fleet.local",
      "firstName": "Approver",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "approver", "temporary": false }],
      "realmRoles": ["approver", "member"]
    },
    {
      "username": "user1",
      "enabled": true,
      "email": "user1@fleet.local",
      "firstName": "Regular",
      "lastName": "One",
      "credentials": [{ "type": "password", "value": "user1", "temporary": false }],
      "realmRoles": ["member"]
    },
    {
      "username": "user2",
      "enabled": true,
      "email": "user2@fleet.local",
      "firstName": "Regular",
      "lastName": "Two",
      "credentials": [{ "type": "password", "value": "user2", "temporary": false }],
      "realmRoles": ["member"]
    }
  ]
}
