{
  "name": "insights-publisher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 8 1 * *" }]
        }
      },
      "id": "cron-monthly",
      "name": "Monthly 1st 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-420, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FLEET_API_BASE_URL }}/v1/insights-publisher/runs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Fleet-Api-Key", "value": "={{ $env.FLEET_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {}
      },
      "id": "http-run",
      "name": "Draft monthly report (-> approval)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-180, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "pending_approval",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "if-pending",
      "name": "Reached approval?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [80, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FLEET_API_BASE_URL }}/v1/service/slack/post",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Fleet-Api-Key", "value": "={{ $env.FLEET_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: 'marketing-alerts', text: 'Monthly insights report failed to reach approval: ' + JSON.stringify($json) }) }}",
        "options": {}
      },
      "id": "slack-alert",
      "name": "Slack failure alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 160]
    }
  ],
  "connections": {
    "Monthly 1st 08:00": {
      "main": [[{ "node": "Draft monthly report (-> approval)", "type": "main", "index": 0 }]]
    },
    "Draft monthly report (-> approval)": {
      "main": [
        [{ "node": "Reached approval?", "type": "main", "index": 0 }],
        [{ "node": "Slack failure alert", "type": "main", "index": 0 }]
      ]
    },
    "Reached approval?": {
      "main": [[], [{ "node": "Slack failure alert", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
